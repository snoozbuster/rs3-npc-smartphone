{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "workspace.library": [
    "types/busted",
    "types/luassert",
    "types/rs/types.lua",
    "types/rs/generated",
    "types/overrides.lua",
    "types/prettyui"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.libraryFiles": "Disable",
  "workspace.ignoreDir": [
    ".tools",
    ".luaenv",
    ".mamba",
    "types"
  ]
}
